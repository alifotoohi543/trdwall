# BACKTEST | SHADOW | LIVE
TRADING_MODE=SHADOW

# OpenAI-compatible LLM endpoint (BoxAPI)
LLM_API_KEY=your-boxapi-key
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_MODEL_FAST=gpt-6-luna
LLM_MODEL_STRONG=gpt-6-sol
# Hard spend caps in USD (read from usage.cost of each response)
LLM_BUDGET_USD_TOTAL=2.5
LLM_BUDGET_USD_DAILY=0.6

# Wallex private API key (only needed for LIVE)
WALLEX_API_KEY=
# Challenge end (UTC); auto-liquidation starts 30 min before
CHALLENGE_END_UTC=2026-10-23T20:30:00Z
